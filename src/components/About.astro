<section id="about" class="about">
  <div class="section-content">
    <h3 class="section-title">
      <span class="title-accent emoji-replace">about </span>
      <span class="mobile-hide">me</span>
    </h3>
    <p class="scroll-reveal-effect">
      I build websites and occasionally convince a collection of unrelated tools
      to cooperate with each other.
      <br /><br />
      Most of my work lives somewhere between development, analytics, digital platforms,
      and solving whatever strange problem showed up that day. I like building useful
      things, figuring out how systems fit together, and tracking down bugs that definitely
      “weren’t there yesterday.”
      <br /><br />
      Away from the computer, I'm usually hunting down good coffee, partway through
      a book, or continuing a very one-sided rivalry with my grandma over crossword
      puzzles.
      <br /><br />
      Have a project, question, book recommendation, or strong coffee opinion? I’m
      always happy to chat.
    </p>
  </div>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      if (window.innerWidth > 1100) {
        const textWrapper = document.querySelector(".scroll-reveal-effect");

        if (textWrapper) {
          const originalNodes = Array.from(textWrapper.childNodes);
          textWrapper.innerHTML = "";

          originalNodes.forEach((node) => {
            if (node.nodeType === Node.TEXT_NODE) {
              const text = node.textContent ?? "";

              text.split("").forEach((character) => {
                if (character === " ") {
                  textWrapper.appendChild(document.createTextNode(" "));
                  return;
                }

                const letter = document.createElement("span");
                letter.className = "letter";
                letter.textContent = character;
                textWrapper.appendChild(letter);
              });
            }

            if (node.nodeName === "BR") {
              textWrapper.appendChild(document.createElement("br"));
            }
          });

          const letters = document.querySelectorAll("#about .letter");

          const adjustOpacity = () => {
            const factor = 3.7; // Controls the speed of the scroll effect
            const offset = 350; // Controls when the scroll effect starts
            const scrollProgress =
              factor * (document.documentElement.scrollTop - offset);
            const scrolled =
              (scrollProgress /
                (document.documentElement.scrollHeight -
                  document.documentElement.clientHeight)) *
              letters.length;
            const fadeRange = 50; // Number of letters over which the opacity will transition

            letters.forEach((letter, index) => {
              const distance = scrolled - index;
              let opacity;

              if (distance > fadeRange) {
                opacity = 1;
              } else if (distance < 0) {
                opacity = 0.1;
              } else {
                opacity = Math.max(0.1, distance / fadeRange);
              }

              (letter as HTMLElement).style.opacity = opacity.toString();
            });
          };
          adjustOpacity();
          document.addEventListener("scroll", adjustOpacity);
        }
      }
    });
  </script>
</section>

<style>
  .about {
    position: relative;
    display: block;
    margin: 0 auto;
  }

  .section-content {
    margin: 0 auto;
    overflow-x: hidden;
  }

  .section-title {
    font-size: 3.5rem;
    color: var(--grey);
  }

  .section-content p {
    width: 80rem;
    max-width: 100%;
    margin: 0 auto;
    font-size: 2.5rem;
    color: var(--body-text);
    font-family: var(--neue-text);
    line-height: 1.7;
    white-space: normal;
  }

  .title-accent {
    color: var(--primary-text);
    font-weight: 700;
    font-size: 6rem;
  }

  .about span.letter {
    font-family: var(--neue-text);
    font-size: 2.5rem;
    color: var(--body-text);
    opacity: 0.1;
    transition: opacity 1s linear;
  }

  @media only screen and (max-width: 761px) {
    .title-accent {
      font-size: 4rem;
    }

    .section-content p {
      font-size: 1.2rem;
      padding-top: 2rem;
      line-height: 1.7;
      letter-spacing: 1px;
    }
  }
</style>
